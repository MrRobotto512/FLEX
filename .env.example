# Copy to .env and fill in. .env is git-ignored.

# TMDB API key (v3 auth) — https://www.themoviedb.org/settings/api
FLEX_TMDB_KEY=

# Optional: an AI arranges the home screen's themed and seasonal rows about
# once a week (titles, years and genres are sent). claude | openai | gemini,
# that provider's API key, and a model in place of the default
# (claude-opus-5-5, gpt-6-astra, gemini-3.8-flash).
FLEX_AI_PROVIDER=
FLEX_AI_KEY=
FLEX_AI_MODEL=

# Folders to scan, separated by ; on Windows
FLEX_LIBRARY=D:\Movies

# Where FLEX keeps its database, posters and transcode segments
FLEX_DATA=./data

# HTTP port and LAN discovery port
FLEX_HTTP_PORT=8484
FLEX_DISCOVERY_PORT=7555

# Name shown to clients
FLEX_NAME=Ryan's PC

# FFmpeg binaries (leave empty to use PATH)
FLEX_FFMPEG=
FLEX_FFPROBE=
# Hardware encoder: auto | nvenc | qsv | amf | mf (GPU through Windows) | software
FLEX_ENCODER=auto

# Tailscale (tsnet). Leave the key empty to disable.
# Generate a reusable, pre-authorized key at https://login.tailscale.com/admin/settings/keys
FLEX_TS_AUTHKEY=
FLEX_TS_HOSTNAME=flex

# Other FLEX PCs on the home network are found by broadcast and their
# libraries listed next to this one's. Add servers the broadcast can't reach
# (another subnet, a PC on the tailnet) as host[:port], comma separated, or
# turn linking off.
# Season prep: the season's titles upscaled ahead of time. Topaz Video AI's
# folder on this PC (empty: the built-in AI shaders), its model, how many
# the AI may pick.
FLEX_PREP=true
FLEX_TOPAZ_DIR=
FLEX_TOPAZ_MODEL=prob-3
FLEX_PREP_MAX=12

FLEX_PEERS=
FLEX_NO_PEERS=false
